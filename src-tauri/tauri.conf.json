{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalForge AI v2",
  "version": "0.1.0",
  "identifier": "io.localforge.LocalForgeAI.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalForge AI v2",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/localforge-backend"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI workspace",
    "longDescription": "A private desktop workspace for local language models, coding and knowledge tools."
  }
}
